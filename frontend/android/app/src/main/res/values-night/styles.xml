<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Dark-theme versions of the app themes. Styles do not merge across resource
      qualifiers, so the whole style is repeated here with light system-bar
      icons and the dark page colour.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/bloomPage</item>
        <item name="android:navigationBarColor">@color/bloomPage</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/bloomPage</item>
        <item name="android:navigationBarColor">@color/bloomPage</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
